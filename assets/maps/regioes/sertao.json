      "spots": {},
      "people": [{"id": "zuleica", "name": "Rainha do Bazar Zuleica", "look": {"preset": "treinadora", "hairStyle": "bun", "hair": "#1a1a22", "skin": "#c98d62", "outfit": "coat", "top": "#e0b030", "trim": "#8a2a6a", "legs": "skirt", "pants": "#8a2a6a", "shoes": "#e0b030", "bagStyle": null}, "x": 6, "y": 4, "dir": "down", "lines": ["Eu conheço todos os desertos, querido. Os de areia e os de ouro. Os de ouro são mais perigosos.", "Meu espelho já mostrou muita coisa. Só não mostra onde eu perdi meus anéis."]}],
