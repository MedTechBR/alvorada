      "people": [{"id": "dr_icaro", "name": "Dr. Ícaro", "look": {"preset": "professor", "hair": "#3a3a3a", "skin": "#efc19b", "outfit": "coat", "top": "#f4f4f0", "trim": "#8a2a6a", "pants": "#6a4a34", "shoes": "#4a3428"}, "x": 8, "y": 5, "dir": "down", "lines": ["Seja bem-vindo ao melhor laboratório de fósseis a leste do Rio Seco. Também o único.", "Traga qualquer fóssil que encontrar. Eu devolvo a vida a ele. Leva uma horinha do relógio do jogo, mas vale a espera."]}, {"id": "lab_assistente", "name": "Assistente Pati", "look": "menina", "x": 4, "y": 8, "dir": "right", "lines": ["O doutor deixa a gente limpar o pó com pincel. Eu acho que é só para a gente não conversar."]}],
