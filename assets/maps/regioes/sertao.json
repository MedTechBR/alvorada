      "spots": {"brasa_dentro": [8, 6, "up"]},
      "people": [{"id": "seu_brasa", "name": "Seu Brasa", "look": {"preset": "montanhista", "hat": "cap", "cap": "#6a4424", "capLogo": "#6a4424", "hair": "#e8e4dc", "skin": "#a06a44", "top": "#c8442a", "trim": "#f2c03a", "pants": "#5a4a34", "shoes": "#4a3428", "bagStyle": null}, "x": 8, "y": 4, "dir": "down", "lines": ["Sou da Elite. É, o de Fogo. Mas só às quartas, ao meio-dia, lá na Cidadela. O resto da semana eu cuido de cabra.", "Sol a pino é a hora do fogo. De manhã ele ainda acorda; à tarde, já cansou. Ao meio-dia, não tem pra ninguém."]}],
      "pets": [{"dex": 672, "x": 3, "y": 6, "wander": 2, "say": "Skiddo cochila em cima de um tapete de lã."}, {"dex": 58, "x": 10, "y": 7, "wander": 1, "sleep": true, "say": "Growlithe dorme esparramado, com o rabo no ar."}],
