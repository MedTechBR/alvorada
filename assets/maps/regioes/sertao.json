  "people": [
    {"id": "forro_sanfona", "name": "Sanfoneiro Zé de Nô", "look": {"preset": "montanhista", "hat": "cap", "cap": "#8a5a2a", "capLogo": "#8a5a2a", "hair": "#3b2a22", "skin": "#c98d62", "top": "#d8a040", "trim": "#8a5a2a", "pants": "#4a5a8a", "shoes": "#4a3428", "bagStyle": "shoulder", "bag": "#8a5a2a"}, "x": 770, "y": 234, "dir": "right", "lines": ["Quer ouvir um xote? Só se for depois da batalha!", "O trio do forró toca o dia todo na praça. A gente só para para descansar o fole."]},
    {"id": "forro_zabumba", "name": "Zabumbeiro Dedé", "look": {"preset": "montanhista", "hat": "cap", "cap": "#3a5a8a", "capLogo": "#8a5a2a", "hair": "#3b2a22", "skin": "#c98d62", "top": "#5a8a4a", "trim": "#8a5a2a", "pants": "#4a5a8a", "shoes": "#4a3428", "bagStyle": "shoulder", "bag": "#8a5a2a"}, "x": 773, "y": 236, "dir": "right", "lines": ["Zabumba é coração batendo. O resto é enfeite."]},
    {"id": "forro_triangulo", "name": "Triangueiro Nenê", "look": {"preset": "treinadora", "hairStyle": "ponytail", "hair": "#2a211c", "skin": "#c98d62", "hat": "cap", "cap": "#d8a040", "capLogo": "#8a5a2a", "top": "#d8442a", "legs": "skirt", "pants": "#8a5a2a", "shoes": "#4a3428"}, "x": 776, "y": 234, "dir": "left", "lines": ["O triângulo é pequeno, mas quem manda no compasso sou eu!"]},
    {"id": "mandacaru_vaqueira", "name": "Vaqueira Cida", "look": {"preset": "treinadora", "hairStyle": "ponytail", "hair": "#2a211c", "skin": "#c98d62", "hat": "cap", "cap": "#d8a040", "capLogo": "#8a5a2a", "top": "#d8442a", "legs": "skirt", "pants": "#8a5a2a", "shoes": "#4a3428"}, "x": 794, "y": 222, "dir": "down", "lines": ["O Seu Brasa tem as cabras mais teimosas do sertão. Fugiram de novo, vê só.", "Se achar um Skiddo desgarrado, traga de volta. Elas gostam de sombra de juazeiro."], "wander": 3},
    {"id": "mandacaru_menino", "name": "Neguinho", "look": "menino", "x": 783, "y": 241, "dir": "down", "lines": ["O Seu Brasa já foi campeão! Hoje só cuida das cabras. E das brasas.", "Eu vou ser da Elite também. Vou ter um Pokémon de fogo bem, bem quente."], "wander": 4, "kid": true},
    {"id": "mandacaru_velha", "name": "Vovó Ana", "look": {"preset": "mae", "hair": "#2a211c", "skin": "#a06a44", "top": "#e0782e", "trim": "#fff6e8"}, "x": 802, "y": 220, "dir": "left", "lines": ["Antigamente o trem trazia gente. Hoje traz só o vento.", "Quando o mandacaru floresce de noite, vem chuva boa. Anota o que eu digo."]},
    {"id": "buriti_vendedora", "name": "Dona Lídia", "look": {"preset": "mae", "hair": "#2a211c", "skin": "#a06a44", "top": "#e0782e", "trim": "#fff6e8"}, "x": 1072, "y": 266, "dir": "down", "lines": ["Tecidos, tapetes e bugigangas do deserto! Tudo com cheiro de sol.", "A Rainha do Bazar sabe quanto vale cada anel. Mas só diz depois do chá."], "wander": 1},
    {"id": "buriti_menino", "name": "Duduzinho", "look": "menino", "x": 1040, "y": 268, "dir": "down", "lines": ["Eu cavei na areia e achei um osso! O doutor Ícaro disse que era de um boi. Que decepção."], "wander": 4, "kid": true},
    {"id": "buriti_cameleiro", "name": "Cameleiro Ali", "look": {"preset": "montanhista", "hat": "cap", "cap": "#8a5a2a", "capLogo": "#8a5a2a", "hair": "#3b2a22", "skin": "#c98d62", "top": "#d8a040", "trim": "#8a5a2a", "pants": "#4a5a8a", "shoes": "#4a3428", "bagStyle": "shoulder", "bag": "#8a5a2a"}, "x": 1008, "y": 270, "dir": "right", "lines": ["Meus Camerupt carregam até as pedras do Lajedo. Pedra boa, pedra pesada.", "No bazar, a Areia Macia é cara de propósito: serve para vender sorriso."]},
    {"id": "buriti_idosa", "name": "Dona Zulmira", "look": {"preset": "mae", "hair": "#2a211c", "skin": "#a06a44", "top": "#e0782e", "trim": "#fff6e8"}, "x": 1054, "y": 270, "dir": "left", "lines": ["Vi o céu cair uma noite. Foi um clarão de dar medo. Na manhã seguinte, a cratera estava lá.", "Dizem que aquilo na cratera é pedra das estrelas. Eu digo que é só uma pedra grande."]},
    {"id": "siri_barqueiro", "name": "Capitão Tonho", "look": {"preset": "montanhista", "hat": "cap", "cap": "#f2f2f2", "capLogo": "#3a8ad8", "hair": "#e8e4dc", "skin": "#c98d62", "top": "#3a6ad8", "trim": "#f2f2f2", "pants": "#f2f2f2", "shoes": "#5a3a24", "bagStyle": null}, "x": 735, "y": 392, "dir": "down", "lines": ["O Barco das Brasas sai às sete e às três."], "viagem": "barco_brasas"},
    {"id": "siri_menina", "name": "Naiara", "look": "menina", "x": 713, "y": 386, "dir": "down", "lines": ["Eu remo mais rápido que o Iraci! Quase.", "Se escutar um barulho de sapo gigante no mangue, não vá lá. É o Alfa. Ele afunda canoa."], "wander": 4, "kid": true},
    {"id": "siri_pescador", "name": "Pescador Zeca", "look": {"preset": "montanhista", "hat": "cap", "cap": "#8a5a2a", "capLogo": "#8a5a2a", "hair": "#3b2a22", "skin": "#c98d62", "top": "#d8a040", "trim": "#8a5a2a", "pants": "#4a5a8a", "shoes": "#4a3428", "bagStyle": "shoulder", "bag": "#8a5a2a"}, "x": 692, "y": 392, "dir": "right", "lines": ["A pesca no mangue é paciência e botas altas.", "De noite o mangue brilha. Dizem que é vaga-lume. Eu acho que é Chinchou."]}
